# Développement — copier vers .env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# Production — copier vers .env.production ou le panneau Vercel
# NEXT_PUBLIC_SITE_URL=https://www.bec-rdc.com
# NEXT_PUBLIC_API_URL=https://www.bec-rdc.com/api

DATABASE_URL=postgresql://bec:mot-de-passe-solide@localhost:5432/bec?schema=public

ADMIN_USERNAME=admin
ADMIN_PASSWORD=choisir-un-mot-de-passe-admin-unique
# 32 caractères minimum en production (ex. : openssl rand -base64 48)
SESSION_SECRET=remplacer-par-une-cle-aleatoire-d-au-moins-32-caracteres

# Gmail : mot de passe d’application, pas le mot de passe du compte
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=bec@gmail.com
EMAIL_PASS=

# Google Analytics 4 (laissé vide tant que le consentement n’est pas prévu / ID non créé)
NEXT_PUBLIC_GA_ID=
